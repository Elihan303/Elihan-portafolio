---
import { info } from "@data";

import ProjectsWrapper from "@components/general/ProjectsWrapper.astro";
import MetaHead from "@components/general/MetaHead.astro";
import Layout from "@layouts/Layout.astro";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <MetaHead
      title={"Proyectos"}
      description={"Todos los proyectos de Elihan"}
      ogImageUrl={"/assets/images/profile.png"}
    />
  </head>

  <body>
    <Layout>
      <section data-animate="fade-up" class="pt-16 pb-8 sm:pt-24 sm:pb-12">
        <p class="text-sm font-semibold tracking-[0.2em] text-blue mb-3">PORTAFOLIO</p>
        <h1 class="text-4xl sm:text-6xl font-bold font-outfit mb-3 dark:text-light">
          Proyectos
        </h1>
        <p class="dark:text-gray mb-12 max-w-xl leading-7">
          Todos los proyectos en los que he trabajado
        </p>
        <ProjectsWrapper projects={info.projects} />
      </section>
    </Layout>
  </body>
</html>
