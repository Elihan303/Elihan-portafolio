---
import { info } from "@data";

import Layout from "@layouts/Layout.astro";
import Hero from "@components/home/Hero.astro";
import Experience from "@components/home/Experience.astro";
import Skills from "@components/home/Skills.astro";
import ProjectsWrapper from "@components/general/ProjectsWrapper.astro";
import MetaHead from "@components/general/MetaHead.astro";

const featureProjects = info.projects.filter((p) => p.isFeatured);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <MetaHead
      title={"Portfolio"}
      description={info.about}
      ogImageUrl={"/assets/images/profile.png"}
    />
  </head>

  <body>
    <Layout>
      <Hero
        name={info.name}
        role={info.role}
        about={info.about}
        socialMedia={info.socialMedia}
      />
      <Experience title={"EXPERIENCIA"} details={info.experience} />
      <Experience title={"EDUCACIÓN"} details={info.education} />
      <Skills skills={info.skills} />
      <section data-animate="fade-up" class="mb-16">
        <h2 class="text-2xl font-bold font-outfit mb-10 flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-blue inline-block"></span>
          PROYECTOS DESTACADOS
        </h2>
        <ProjectsWrapper projects={featureProjects} />
      </section>
    </Layout>
  </body>
</html>