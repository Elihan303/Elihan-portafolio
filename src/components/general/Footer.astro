---
import { info } from "@data";
---

<footer class="border-t border-dark/5 dark:border-white/10 mt-24 bg-white/30 dark:bg-white/[0.02]">
  <div class="container py-8 flex flex-col sm:flex-row justify-between items-center gap-6">
    <p class="text-sm dark:text-gray text-center sm:text-left">
      © {new Date().getFullYear()} Derechos reservados a <strong class="dark:text-light">Elihan</strong>
    </p>
    <div class="flex items-center gap-3">
      <a
        aria-label="Twitter"
        href={info.socialMedia.twitter}
        target="_blank"
        rel="noopener noreferrer"
        class="w-9 h-9 flex items-center justify-center rounded-lg border border-gray/30 dark:border-gray/20 hover:border-blue dark:hover:border-blue hover:text-blue dark:hover:text-blue transition-colors dark:text-gray"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
      </a>
      <a
        aria-label="GitHub"
        href={info.socialMedia.github}
        target="_blank"
        rel="noopener noreferrer"
        class="w-9 h-9 flex items-center justify-center rounded-lg border border-gray/30 dark:border-gray/20 hover:border-blue dark:hover:border-blue hover:text-blue dark:hover:text-blue transition-colors dark:text-gray"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
      </a>
      <a
        aria-label="LinkedIn"
        href={info.socialMedia.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="w-9 h-9 flex items-center justify-center rounded-lg border border-gray/30 dark:border-gray/20 hover:border-blue dark:hover:border-blue hover:text-blue dark:hover:text-blue transition-colors dark:text-gray"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
      </a>
      <a
        aria-label="Email"
        href={`mailto:${info.socialMedia.email}`}
        class="w-9 h-9 flex items-center justify-center rounded-lg border border-gray/30 dark:border-gray/20 hover:border-blue dark:hover:border-blue hover:text-blue dark:hover:text-blue transition-colors dark:text-gray"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      </a>
    </div>
  </div>
</footer>
