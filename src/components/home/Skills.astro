---
import { ISkillCategory } from "@types";

const { skills } = Astro.props as { skills: ISkillCategory[] };
---

<section data-animate="fade-up" class="mb-16">
  <h2 class="text-2xl font-bold font-outfit mb-10 flex items-center gap-3">
    <span class="w-2 h-2 rounded-full bg-blue inline-block"></span>
    Habilidades
  </h2>
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {
      skills.map((category) => (
        <div class="bg-gray-100 dark:bg-[#1e1e1e] rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow duration-300">
          <h3 class="text-lg font-semibold font-outfit mb-4 text-blue">{category.category}</h3>
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <span class="px-3 py-1.5 text-sm rounded-lg bg-white dark:bg-dark border border-gray/30 dark:border-gray/20 dark:text-light shadow-sm">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>