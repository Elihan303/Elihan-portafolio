---
const { skills } = Astro.props as { skills: string[] };
---

<section data-animate="fade-up" class="mb-16">
  <h2 class="text-2xl font-bold font-outfit mb-10 flex items-center gap-3">
    <span class="w-2 h-2 rounded-full bg-blue inline-block"></span>
    Tecnologías
  </h2>
  <div class="flex flex-wrap gap-3">
    {skills.map((skill) => (
      <span class="px-5 py-2.5 rounded-full border border-blue/30 dark:border-blue/20 bg-blue/5 dark:bg-blue/5 text-blue font-medium text-sm hover:bg-blue hover:text-white dark:hover:text-white transition-colors duration-300 cursor-default shadow-sm">
        {skill}
      </span>
    ))}
  </div>
</section>