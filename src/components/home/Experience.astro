---
import { IExperiences } from "@types";

const { title, details } = Astro.props as IExperiences;
---

<section data-animate="fade-up" class="mb-20">
  <h2 class="text-2xl font-bold font-outfit mb-9 flex items-center gap-3">
    <span class="w-2 h-2 rounded-full bg-blue inline-block"></span>
    {title}
  </h2>
  <div class="relative pl-8 border-l-2 border-blue/30">
    {
      details.map((item) => (
        <div class="relative pb-12 last:pb-0">
          <div class="absolute -left-[calc(2rem+5px)] top-1 w-4 h-4 rounded-full bg-blue border-2 border-light dark:border-dark"></div>
          <div class="border border-dark/5 bg-white/60 dark:border-white/10 dark:bg-white/5 rounded-2xl p-6 shadow-sm hover:-translate-y-1 hover:shadow-xl hover:shadow-dark/5 transition-all duration-300">
            <div class="flex flex-wrap justify-between items-start gap-2 mb-3">
              <h3 class="text-xl font-semibold font-outfit">{item.name}</h3>
              <span class="text-xs font-mono px-3 py-1 rounded-full bg-blue/10 text-blue dark:text-blue whitespace-nowrap">
                {item.startDate} — {item.endDate}
              </span>
            </div>
            <p class="text-sm text-blue mb-3">{item.location}</p>
            <ul class="space-y-2">
              {item.description.map((desc) => (
                <li class="dark:text-gray text-sm leading-relaxed flex items-start gap-2">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-blue shrink-0"></span>
                  {desc}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </div>
</section>
