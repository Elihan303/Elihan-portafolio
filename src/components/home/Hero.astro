---
import { IHeroProps } from "@types";
import HeroSocial from "@components/general/HeroSocial.astro";

const { name, role, about, socialMedia, profileImage } = Astro.props as IHeroProps;
---

<section class="min-h-[calc(100vh-80px)] sm:min-h-[calc(100vh-123px)] flex items-center py-14 sm:py-20">
  <div class="grid md:grid-cols-2 gap-14 lg:gap-20 items-center w-full">
    <div data-animate="fade-up">
      <p class="inline-flex items-center gap-2 rounded-full border border-blue/30 bg-blue/10 px-3 py-1.5 text-sm font-medium text-dark dark:text-light mb-5">
        <span class="h-2 w-2 rounded-full bg-blue shadow-[0_0_12px_#33d2ff]"></span>
        Disponible para nuevos retos
      </p>
      <p class="text-lg dark:text-gray mb-2">Hola, soy</p>
      <h1 class="main-heading text-4xl sm:text-6xl lg:text-7xl !m-0 !mb-5">{name}</h1>
      <p class="text-xl font-outfit font-semibold text-blue mb-6 tracking-wide">{role}</p>
      <p class="dark:text-gray text-base mb-8 leading-8 max-w-xl">
        {about}
      </p>
      <HeroSocial socialMedia={socialMedia} />
    </div>
    <div data-animate="fade-up" class="flex justify-center md:justify-end">
      <div class="relative p-3 rounded-[2rem] border border-white/70 bg-white/40 shadow-2xl shadow-blue/10 backdrop-blur-sm dark:border-white/10 dark:bg-white/5">
        <div class="w-64 h-64 sm:w-80 sm:h-80 rounded-[1.5rem] overflow-hidden border border-blue/30 shadow-xl shadow-blue/20">
          <img
            src={profileImage ?? "/assets/images/profile.png"}
            alt={name}
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-5 -right-5 w-24 h-24 bg-blue/20 rounded-full blur-xl -z-10"></div>
        <div class="absolute -top-5 -left-5 w-32 h-32 bg-purple-500/20 rounded-full blur-xl -z-10"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .main-heading {
    display: inline-block;
    font-style: normal;
    font-weight: 600;
    background: linear-gradient(89.81deg, #9845e8 -1.72%, #33d2ff 54.05%, #dd5789 99.78%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-fill-color: transparent;
    background-size: 150% 150%;
    animation: gradient 15s ease infinite;
    line-height: 1.2;
  }

  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
</style>
